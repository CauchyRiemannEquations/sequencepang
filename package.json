{
  "name": "sequence-pang",
  "version": "1.0.0",
  "description": "수열팡(Sequence Pang) - 실시간 멀티플레이어 경쟁 모드 지원",
  "scripts": {
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/engine/*.test.js",
    "test:backend": "node --test tests/firebase/unit.test.cjs",
    "emulators": "node scripts/emulators.cjs start",
    "test:emulators": "node scripts/emulators.cjs test",
    "configure:firebase": "node scripts/configure-firebase.cjs",
    "deploy:firebase": "node scripts/deploy-firebase.cjs",
    "test:browser": "node scripts/emulators.cjs browser"
  },
  "keywords": [
    "sequence-pang",
    "melon",
    "puzzle",
    "multiplayer"
  ],
