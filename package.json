  "license": "MIT",
  "dependencies": {
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "14.27.0",
    "playwright": "^1.62.1",
    "vite": "^5.4.21"
  },
  "type": "module"
}
