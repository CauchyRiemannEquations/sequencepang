# Public Web Config from the EXISTING Firebase project's registered web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-southeast1
# Optional override for the derived Function URL.
VITE_FIREBASE_FUNCTIONS_URL=
# Local only. NEVER enable in Vercel production/preview.
VITE_USE_FIREBASE_EMULATORS=false
